# Salin ke .env.local lalu isi. JANGAN commit file .env* selain file ini.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Anon key lama atau publishable key baru (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — untuk Supabase Storage (foto bukti bayar & komplain). JANGAN diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Project Settings → Database → Connection string) ---
# Pakai "Transaction pooler" (port 6543) untuk Vercel.
DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# URL publik aplikasi, dipakai di link email login & portal penghuni
APP_URL=http://localhost:3000

# Rahasia untuk endpoint cron (Vercel Cron mengirimnya otomatis). Buat: openssl rand -hex 32
CRON_SECRET=
# Kunci enkripsi NIK, 32 byte base64. Buat: openssl rand -base64 32
# JANGAN diganti setelah ada NIK tersimpan (NIK lama tidak bisa dibaca lagi).
NIK_ENCRYPTION_KEY=

# Kunci pembuat link portal penghuni (min. 16 karakter). Buat: openssl rand -hex 32
# Mengganti nilai ini membuat SEMUA link portal lama tidak berlaku.
PORTAL_SECRET=

# --- WhatsApp (Fonnte: https://fonnte.com → Device → Token) ---
# Kosong di development = pesan hanya dicetak di log server.
FONNTE_TOKEN=

# Rahasia webhook status pesan Fonnte (bebas, min. 16 karakter); URL webhook:
#   https://DOMAIN/api/webhooks/fonnte?secret=<nilai ini>
FONNTE_WEBHOOK_SECRET=

# --- Payment gateway Midtrans (dashboard.midtrans.com → Settings → Access Keys) ---
# Kosong = tombol "Bayar online" tidak tampil di portal.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- Simulasi lokal (diisi otomatis oleh `pnpm sim`; biarkan kosong di production) ---
# FONNTE_API_URL=http://localhost:3200/fonnte/send
# MIDTRANS_BASE_URL=http://localhost:3200/midtrans

# --- Belum dipakai ---
SENTRY_DSN=

# --- Development tanpa Supabase (opsional, diabaikan di production) ---
# Isi dengan UUID user di auth.users database lokal agar bisa membuka dashboard
# tanpa login. RLS tetap berlaku sebagai user ini.
KOSKU_DEV_PREVIEW_USER_ID=
# Email owner untuk `pnpm db:seed`
SEED_OWNER_EMAIL=

# --- MCP Stitch (desain UI) — dibaca oleh .mcp.json, bukan oleh aplikasi ---
# Simpan di pengaturan environment Claude Code, jangan di file yang di-commit.
STITCH_API_KEY=
